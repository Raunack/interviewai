# MockPrep — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# For Vercel deployments, add these in: Project → Settings → Environment Variables
# NEVER commit .env.local — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Providers (required for core functionality) ───────────────────────────

# Groq (primary AI provider — free tier at console.groq.com)
# Key format: gsk_...
GROQ_API_KEY=

# Google Gemini (fallback AI provider — free tier at aistudio.google.com)
# Key format: AIza...
GEMINI_API_KEY=

# ── Supabase (required for auth and session storage) ─────────────────────────

# Project URL — found in: Project Settings → API → Project URL
SUPABASE_URL=

# Service role secret key — found in: Project Settings → API → service_role
# KEEP THIS SERVER-SIDE ONLY. Never expose in client-side code.
SUPABASE_SERVICE_KEY=

# Public anon key — found in: Project Settings → API → anon public
# Safe to expose in the browser (used by middleware and auth flow).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Optional: ElevenLabs TTS (enhances /live-interview voice quality) ────────
# Without this key the app falls back to browser Web Speech API (free, lower quality).
# Get a free key at elevenlabs.io → Profile → API Keys
# NEXT_PUBLIC prefix is required — this key is used directly in the browser.
NEXT_PUBLIC_ELEVENLABS_API_KEY=

# ── Optional: Resend (email notifications for user feedback submissions) ─────
# Without these the feedback form still works — it just won't send email alerts.
# Get a free key at resend.com → API Keys
RESEND_API_KEY=
# Sender address for feedback emails (must be a verified domain on Resend)
RESEND_FROM=MockPrep <onboarding@resend.dev>
